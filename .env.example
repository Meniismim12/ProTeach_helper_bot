# ── Majburiy ────────────────────────────────────────────────────────────────
# BotFather bergan token
BOT_TOKEN=123456:AA...

# Bosh admin (egasi) Telegram ID si. Botga /id yozib bilib olasiz
OWNER_ID=0

# ── Baza ────────────────────────────────────────────────────────────────────
# Bo'sh bo'lsa — quyidagi SQLite fayli ishlatiladi (lokal / VPS uchun).
# Render'da esa Neon Postgres satrini qo'ying, aks holda ma'lumot yo'qoladi:
# DATABASE_URL=postgresql://user:parol@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=
DB_PATH=data/bot.db

# ── Rejim ───────────────────────────────────────────────────────────────────
# Bo'sh bo'lsa — polling (lokal / VPS).
# Render bu qiymatni RENDER_EXTERNAL_URL orqali o'zi beradi, qo'lda shart emas.
# WEBHOOK_BASE_URL=https://proteach-bot.onrender.com
WEBHOOK_BASE_URL=
WEBHOOK_PATH=/webhook
# Bo'sh qoldirsangiz tokendan avtomatik hosil qilinadi
WEBHOOK_SECRET=
# Render PORT ni o'zi beradi
PORT=8080

# ── Yuborish ────────────────────────────────────────────────────────────────
# Kanallar orasidagi pauza (soniya)
SEND_DELAY=0.06
# Albom qismlarini yig'ish uchun kutish (soniya)
ALBUM_LATENCY=0.7
